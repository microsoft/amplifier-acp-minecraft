[Unit]
Description=Minecraft agent for %i
After=minecraft-workshop.service
[Service]
WorkingDirectory=%h/.local/share/minecraft-workshop/app
ExecStart=%h/.local/share/minecraft-workshop/app/.venv/bin/python %h/.local/share/minecraft-workshop/app/adapter.py --home %h/.local/share/minecraft-workshop/%i
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077
[Install]
WantedBy=default.target
