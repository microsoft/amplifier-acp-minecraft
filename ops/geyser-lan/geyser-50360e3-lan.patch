+package org.geysermc.geyser.network.bedrock.nethernet;
+
+import org.cloudburstmc.netty.util.nethernet.TransportIdentityBinding;
+
+/** Only an authenticated discovery login echoing this server lifetime nonce can use LAN compatibility. */
+public final class LanLoginPolicy {
+    private LanLoginPolicy() { }
+    public static boolean trusted(boolean signedChain, boolean lanSource,
+            TransportIdentityBinding.State state, boolean nonceMatches) {
+        return signedChain && lanSource && state == TransportIdentityBinding.State.NONE && nonceMatches;
+    }
+}
